
<library file="*.cc" name="DataFormatsPlugins">
  <use name="alpaka"/>
  <use name="FWCore/Framework"/>
  <use name="DataFormats/PortableTestObjects"/>
  <use name="DataFormats/Portable"/>
  <flags EDM_PLUGIN="1"/>
</library>

<library file="alpaka/*.cc" name="DataFormatsPluginsPortable">
  <use name="DataFormats/SoATemplate"/>
