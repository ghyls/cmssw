#!/usr/bin/env python3

"""
This script splits an HLT configuration into local and remote processes
by offloading selected modules or sequences.

This tool analyzes data dependencies between CMSSW modules and generates
the derived configuration files:
    - one *local* process config
    - one or multiple *remote* process configs

Modules specified for offloading will be moved to the remote processes.
If multiple remote processes are needed, individual parameters should
be separated by ":".
Any required data products are automatically identified and forwarded
between processes unless the producing module is explicitly marked as
shared.

Notes:
    - Dependencies and the schedule come from the framework itself: a single cmsRun job
      runs the configuration with the DumpDependencyGraph service and the
      DumpProductNames analyzer attached, so mayConsumes and EDAlias indirection, the
      products of the Source and those read from the input are all accounted for.
    - Only the products consumed on the other side are forwarded, matched by type,
      product instance name and process name.
    - Module execution order inside dependency groups is preserved.

Some TBDs:
    - (maybe later?) Do more elegant file dumping
    - Test if the results and througputs are the same as in manual split

"""

import sys

from FWCore.ParameterSet.processFromFile import processFromFile
from HeterogeneousCore.MPICore.configuration_splitter.multiple_remotes_option_parser import parse_mpi_style_args
from HeterogeneousCore.MPICore.configuration_splitter.process_builders import annotate_portable_types
from HeterogeneousCore.MPICore.configuration_splitter.process_dump import ProcessDump, SerialiserTypeGetter
from HeterogeneousCore.MPICore.configuration_splitter.split_remote import split_remote


def main():
    configs = parse_mpi_style_args(sys.argv[1:])

    if configs[0].verbose:
        for i, cfg in enumerate(configs):
            print(f"\n=== Process {i} ===")
            print(cfg)

    local_process = processFromFile(str(configs[0].config))

    # -- Get product names and their dependency graph from the framework --

    if configs[0].verbose:
        if configs[0].reuse_dumps:
            print("Trying to read the product names and dependency graph from existing files...")
        else:
            print("Launching cmsRun to dump the product names and dependency graph of the process...")

    cpp_names_of_the_products, dependency_graph = ProcessDump(local_process, reuse=configs[0].reuse_dumps).run()

    if configs[0].verbose:
        print("Got the product names and the dependency graph")

    # -- Give device products a name that works on every backend --
    #
    # The product names collected above contain the backend used on the machine
    # where they were produced, and thus they cannot go into a configuration
    # that is meant to be runable on every backend. The output of
    # hltSiPixelClustersSoA, for instance, is dumped
    #
    #   on a GPU machine as  edm::DeviceProduct<SiPixelClustersDevice<alpaka::DevUniform...> >
    #   on a CPU machine as  SiPixelClustersHost
    #
    # The first hardcodes a specific backend. The second names no backend at
    # all, and is indistinguishable from an ordinary host product. The goal of
    # the code below is to translate that into:
    #
    #   ALPAKA_ACCELERATOR_NAMESPACE::SiPixelClustersSoACollection
    #
    # which the MPISenderPortable and MPIReceiverPortable know how to handle.
    # This is done by running a cheap cmsRun job twice, once on this machine's
    # backend, and another one forcing the serial_sync backend. This is because
    #
    # 1. Every backend registers a serialiser under the mangled typeid of
    # `TYPE_HOST`.
    # 2. Only the CPU backends, additionally register it under the portable
    # name. ALPAKA_ACCELERATOR_NAMESPACE::TYPE_DEVICE. 
    # (See the docstring in SerialiserFactoryDevice.h).
    #
    # The two dumps allow to translate what this machine named a type, into
    # the ALPAKA_ACCELERATOR_NAMESPACE::TYPE_DEVICE form of that type. Despite
    # this machine's backend.
    #
    # On a CPU dump with no device products at all, device products are
    # identified by annotate_portable_types, by looking at whether the module
    # which produced them has an "@alpaka" label.
    #
    # This approach allows the local and remote configurations produced by any
    # machine (CPU-only, Nvidia or AMD) to be identical.
    if any(process_args.use_portable_mpi_modules for process_args in configs):
        if configs[0].verbose:
            print("Launching cmsRun to get the backend-independent names of device product types...")

        annotate_portable_types(cpp_names_of_the_products, SerialiserTypeGetter().run(), local_process)

        if configs[0].verbose:
            print("Got backend-independent device product type names")

    for process_args in configs:
        remote_process = split_remote(local_process, process_args, cpp_names_of_the_products, dependency_graph)
        process_args.output_remote.parent.mkdir(parents=True, exist_ok=True)
        process_args.output_remote.write_text(remote_process.dumpPython())

    configs[0].output_local.parent.mkdir(parents=True, exist_ok=True)
    configs[0].output_local.write_text(local_process.dumpPython())


if __name__ == "__main__":
    main()
